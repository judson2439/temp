{
  "rewrites": [
    {
      "source": "/payment-success",
      "destination": "/payment-success.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/payment-success",
      "dest": "/payment-success.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
